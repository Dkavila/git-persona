# Compiled binaries at the repo root.
# These patterns are anchored with a leading slash: an unanchored "git-pilot"
# would also match the cmd/git-pilot package directory and silently exclude
# the entry point from version control.
/git-pilot
/git-pilot.exe
/bin/
/dist/

# Test & coverage output
*.out
coverage.html

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Local env
.env
